# fubu-verify-bot environment — copy to a ROOT-OWNED file (e.g. /home/ubuntu/.fubu_verify_env),
# fill in, chmod 600. NEVER commit the real file. systemd loads it via EnvironmentFile.

# --- Required ---
DISCORD_BOT_TOKEN=            # bot token from the Discord Developer Portal (this new app)
GUILD_ID=                     # the FUBU server id
VERIFY_CHANNEL_ID=            # the text channel where members open verification threads
VERIFIED_ROLE_ID=            # the role a mod assigns once a person is verified (the trigger)

# --- Optional ---
UNVERIFIED_ROLE_ID=          # if set, "pending" (nudge/stale) = owner still holds this role

# --- Recommended (nudges + warnings) ---
MOD_ROLE_ID=                  # role to ping about pending threads (blank = no ping)
MOD_ALERT_CHANNEL_ID=         # where nudges post (blank = post in the verify channel)
UNVERIFIED_CHAT_CHANNEL_ID=   # where thread-less members get their pre-kick @mention warning
                              # (blank = verify channel). Members WITH a thread are warned in it.
MOD_CONFLICT_CHANNEL_ID=      # where dual-role members are flagged + the daily digest is posted
CONFLICT_PING=false           # per-message conflict flags (OFF: conflicts live in the daily digest)
CONFLICT_REPING_HOURS=24      # (if CONFLICT_PING) don't re-flag the same member more often than this
CONFLICT_MAX_PER_SWEEP=25     # (if CONFLICT_PING) cap flags per sweep

# --- Daily digest (24h recap embed, posted to MOD_CONFLICT_CHANNEL_ID) ---
DIGEST_ENABLED=true
DIGEST_HOUR=9                 # local server-time hour (0-23) to post the daily digest
DIGEST_CONFLICT_LIST_MAX=40   # cap conflict usernames listed in the digest embed

# --- Feature toggles (default all on) ---
FEATURE_NUDGE=true            # ping mods about pending threads
FEATURE_STALE=true            # warn (mention) then kick+delete stale unverified threads
STALE_KICK=true               # false = delete the stale thread but do NOT kick the owner
REAP_ORPHANS=true             # delete threads whose owner has left the server (no kick needed)
PURGE_WARN_CHANNEL_THREADS=true  # delete EVERY thread in the unverified-chat channel (any status)

# --- Timing (reap is measured from when a member JOINED) ---
WARN_DAYS=6                   # days after joining to warn an unverified member (@mention)
KICK_DAYS=7                   # days after joining to kick if still unverified (must be > WARN_DAYS)
NUDGE_AFTER_HOURS=24          # a pending thread is "nudgeable" once older than this
NUDGE_EVERY_HOURS=24          # minimum gap between re-nudges of the same thread
SWEEP_INTERVAL_MIN=60         # how often the sweep runs (min). Warn/kick fire within one interval
                              # of crossing the day boundary, so 60 = up to ~1h late. Lower = tighter.

# --- Safety ---
DRY_RUN=true                  # true = log intended actions, perform none. Flip to false to go live.
STATE_FILE=/home/ubuntu/.fubu_verify_state.json
